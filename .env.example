# App Configuration
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

# Supabase (Database + Storage + Auth)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Clerk (User Authentication)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxx
CLERK_SECRET_KEY=sk_test_xxx
CLERK_WEBHOOK_SECRET=whsec_xxx

# Stripe (Payments)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxx
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx

# OpenRouter (AI Gateway - Claude 3.5 Sonnet + Fallbacks)
OPENROUTER_API_KEY=sk-or-v1-xxx
NEXT_PUBLIC_OPENROUTER_REFERER=https://aurumadvisement.com

# HubSpot (CRM)
HUBSPOT_API_KEY=pat-na1-xxx

# HumbleFax (State Filing - Admin Use Only)
HUMBLEFAX_API_KEY=hf_xxx

# D&B (Credit Monitoring)
DNB_API_KEY=dnb_xxx
DNB_PARTNER_ID=your-partner-id

# Experian (Business Credit)
EXPERIAN_API_KEY=exp_xxx
EXPERIAN_CLIENT_ID=your-client-id
EXPERIAN_CLIENT_SECRET=your-client-secret

# Equifax (Business Credit)
EQUIFAX_API_KEY=eq_xxx

# Deepseek R1 (Admin Voice Agent)
DEEPSEEK_API_KEY=sk-xxx

# Retell.ai (Voice Infrastructure)
RETELL_API_KEY=retell_xxx

# N8N Webhooks (Automation Workflows)
N8N_BASE_URL=https://n8n.yourdomain.com
N8N_WEBHOOK_SECRET=your-webhook-secret

# Email (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@aurumadvisement.com
SMTP_PASSWORD=your-app-password
SMTP_FROM=Aurum Advisement <support@aurumadvisement.com>

# Social Media APIs (Market Me Integration)
FACEBOOK_APP_ID=xxx
FACEBOOK_APP_SECRET=xxx
INSTAGRAM_ACCESS_TOKEN=xxx
LINKEDIN_CLIENT_ID=xxx
LINKEDIN_CLIENT_SECRET=xxx
TWITTER_API_KEY=xxx
TWITTER_API_SECRET=xxx

# Google Services (Market Me - Google Business Profile)
GOOGLE_MAPS_API_KEY=xxx
GOOGLE_CLIENT_ID=xxx
GOOGLE_CLIENT_SECRET=xxx

# Apple MapKit (Market Me - Apple Maps Listing)
APPLE_MAPKIT_KEY=xxx

# Shipping (Mail Bundles)
USPS_API_KEY=xxx
FEDEX_API_KEY=xxx
UPS_API_KEY=xxx

# Error Tracking (Optional but Recommended)
SENTRY_DSN=https://xxx@sentry.io/xxx

# Analytics (Optional)
NEXT_PUBLIC_GOOGLE_ANALYTICS=G-XXXXXXXXXX
